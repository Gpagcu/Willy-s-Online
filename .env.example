# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# Neon dashboard -> your project -> Connect -> Connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon dashboard -> your project -> Auth -> Configuration -> "Auth URL"
# Looks like: https://ep-xxxxx.neon.tech/neondb/auth   (do NOT add the VITE_ prefix)
NEON_AUTH_URL=https://ep-xxxxx.neon.tech/neondb/auth

# The account that signs up with this email (and verifies it) becomes the store admin.
# Use a real email you can open.
ADMIN_EMAIL=you@gmail.com

# Leave this line OUT in real life. Set to false ONLY while testing if verification emails won't arrive
# (and switch "Verify at Sign-up" off in the Neon console). With it off, make yourself admin with the SQL in the README.
# REQUIRE_VERIFIED_EMAIL=false

# Shown to customers at checkout
GCASH_NUMBER=09XX-XXX-XXXX
GCASH_NAME=Willy's Leather Craft
BANK_DETAILS=Bank name / Account name / Account number

PORT=3000
